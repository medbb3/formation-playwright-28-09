{
  "name": "mini-banque-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "test:real": "playwright test --project=chromium --project=api",
    "test:mock": "playwright test --project=mocked",
    "test:api": "playwright test --project=api",
    "test:visuel": "playwright test --project=visuel",
    "test:mobile": "playwright test --project=mobile",
    "test:a11y": "playwright test --grep @a11y",
    "test:update-snapshots": "playwright test --project=visuel --update-snapshots",
    "lint": "eslint tests",
    "hooks:install": "node scripts/install-hooks.mjs",
    "test:docker": "docker compose -f ../docker-compose.yml -f ../docker-compose.tests.yml run --rm --build tests",
    "report:allure": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "gates": "node ../scripts/quality-gate.mjs test-results/report.json pr && node ../scripts/coverage-criteres.mjs specs tests",
    "kpi": "node ../scripts/kpi-hebdo.mjs test-results/report.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "@faker-js/faker": "^9.3.0",
    "csv-parse": "^5.6.0",
    "@axe-core/playwright": "^4.10.1",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.2.0",
    "typescript-eslint": "^8.19.0",
    "@eslint/js": "^9.17.0",
    "allure-playwright": "^3.0.9",
    "allure-commandline": "^2.32.0",
    "monocart-reporter": "^2.9.14",
    "dotenv": "^16.4.7"
  }
}
